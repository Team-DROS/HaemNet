# ──────────────────────────────────────────────
# AI Blood Dispatch Network — Backend .env
# Copy this file to `.env` and fill in real values.
# ──────────────────────────────────────────────

# ── Neo4j AuraDB ──
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
# Data layer: "mongodb" (default) or "neo4j"
DB_BACKEND=mongodb
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=haemnet

# ── Twilio Telephony ──
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number


# ── Sarvam AI (STT / TTS) ──
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_BASE_URL=https://api.sarvam.ai
VOICE_INTENT_MODE=legacy
VOICE_INTENT_MODEL=sarvam-105b

# ── App Settings ──
APP_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=["http://localhost:3000","http://localhost:19006"]
SERVER_BASE_URL=http://localhost:8000

# ── Expo Push Notifications ──
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ── Twilio Audio Streaming ──
TWILIO_AUDIO_WS_PATH=/ws/twilio/audio-stream

# ── Hospital platform ──
# Admin panel sign-in (disabled until both are set). Hash: see backend/config.py
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Public dashboard URL, used in verification emails
DASHBOARD_URL=http://localhost:8081
# Private folder for hospital licence uploads (use a persistent disk or move to S3/R2)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Outgoing email (verification, approval). Without SMTP_HOST the mails are not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Bot protection and contact form ──
# Cloudflare Turnstile secret key; empty disables the check
TURNSTILE_SECRET=
# Inbox that receives contact form messages (needs SMTP_* above)
CONTACT_TO=

# ── Call cost guards ──
MAX_DONORS_PER_DISPATCH=50
MAX_DISPATCHES_PER_HOSPITAL_DAY=30

# Log format: text or json
LOG_FORMAT=text
