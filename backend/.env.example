# ──────────────────────────────────────────────
# AI Blood Dispatch Network — Backend .env
# Copy this file to `.env` and fill in real values.
# ──────────────────────────────────────────────

# ── Neo4j AuraDB ──
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
# Data layer: "mongodb" (default) or "neo4j"
DB_BACKEND=mongodb
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=haemnet

# ── Telephony ──
# Provider behind the TelephonyProvider interface (only "twilio" is implemented today)
TELEPHONY_PROVIDER=twilio

# ── Twilio Telephony ──
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number


# ── Sarvam AI (STT / TTS) ──
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_BASE_URL=https://api.sarvam.ai
VOICE_INTENT_MODE=legacy
VOICE_INTENT_MODEL=sarvam-105b

# ── App Settings ──
APP_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=["http://localhost:3000","http://localhost:19006"]
SERVER_BASE_URL=http://localhost:8000

# ── Expo Push Notifications ──
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ── Twilio Audio Streaming ──
TWILIO_AUDIO_WS_PATH=/ws/twilio/audio-stream

# ── Hospital platform ──
# Admin panel sign-in (disabled until both are set). Hash: see backend/config.py
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Public dashboard URL, used in verification emails
DASHBOARD_URL=http://localhost:8081
# Private folder for hospital licence uploads (use a persistent disk or move to S3/R2)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Outgoing email (verification, approval). Without SMTP_HOST the mails are not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Optional Brevo HTTPS delivery (takes priority over SMTP when configured).
# Required sender: SMTP_FROM; verify it in Brevo. Keep this API key private.
BREVO_API_KEY=
SMTP_PASSWORD=
SMTP_FROM=

# ── Bot protection and contact form ──
# Cloudflare Turnstile secret key; empty disables the check
TURNSTILE_SECRET=
# Inbox that receives contact form messages (needs SMTP_* above)
CONTACT_TO=

# ── Call cost guards ──
MAX_DONORS_PER_DISPATCH=50
MAX_DISPATCHES_PER_HOSPITAL_DAY=30

# Log format: text or json
LOG_FORMAT=text

# ── Redis ──
# Needed to run more than one backend instance: shares rate limits, call quotas and live dashboard updates.
# Example: rediss://default:password@host:6379
REDIS_URL=

# ── Document storage (private S3 or Cloudflare R2 bucket; empty uses UPLOAD_DIR on local disk) ──
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=hospital-documents/

# ── Scale and resilience ──
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=100
# Call starts per second per instance (Twilio rate limits; divide by the number of instances)
TWILIO_CALLS_PER_SECOND=10
# Largest JSON request body accepted (uploads have their own MAX_UPLOAD_MB)
MAX_REQUEST_BODY_KB=256

# Share of requests Sentry traces (0 to 1)
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Donor phone verification ──
# Require a verified phone to create a donor account (turn on once the donor app supports the code flow).
# Without REDIS_URL the code is only valid on the instance that sent it.
DONOR_OTP_REQUIRED=false
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# ── Call retries ──
# Retry a busy or unanswered call this many times (0 = off), after this many seconds
CALL_MAX_RETRIES=1
CALL_RETRY_DELAY_SECONDS=180
