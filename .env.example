# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file — it's already in .gitignore.

# --- Backend configuration ----------------------------------------------
APP_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
SERVER_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:19006","http://localhost:8081"]

NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-database-password
# Data layer: "mongodb" (default) or "neo4j"
DB_BACKEND=mongodb
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=haemnet
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# ── Email: donor sign-in codes ──
# Production (Render free blocks SMTP): Brevo HTTPS API, free 300 emails/day.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=HaemNet
# Local alternative: SMTP with STARTTLS (for example Gmail + an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_BASE_URL=https://api.sarvam.ai

# Geocoding uses OpenStreetMap Nominatim (free, no API key required) —
# see database/ingest_csv.py.

