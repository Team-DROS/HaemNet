# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file — it's already in .gitignore.

# --- Backend configuration ----------------------------------------------
APP_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
SERVER_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:19006","http://localhost:8081"]

NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-database-password
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=haemnet
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_BASE_URL=https://api.sarvam.ai

# Geocoding uses OpenStreetMap Nominatim (free, no API key required) —
# see database/ingest_csv.py.

