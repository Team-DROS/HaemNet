{
  "name": "HaemNet Design Tokens",
  "version": "2.0.0",
  "theme": "light-first",
  "color": {
    "surface": {
      "canvas": "#F5F7FA",
      "canvasWarm": "#FAF9F7",
      "primary": "#FFFFFF",
      "secondary": "#F8FAFC",
      "selected": "#EDF2F9",
      "emergency": "#FFF9F8"
    },
    "border": {
      "default": "#E4E8EF",
      "soft": "#EDF0F5",
      "divider": "#F1F3F7",
      "emergency": "#F4D9D6"
    },
    "text": {
      "primary": "#0F1A2B",
      "secondary": "#58637A",
      "muted": "#8B95A7",
      "faint": "#AEB6C4",
      "disabled": "#C3CAD5"
    },
    "emergency": {
      "base": "#D92D20",
      "text": "#B42318",
      "surface": "#FEF3F2"
    },
    "success": {
      "base": "#0E9B6C",
      "text": "#08734F",
      "surface": "#E7F6EF"
    },
    "processing": {
      "base": "#2E5FEA",
      "text": "#1E46B8",
      "surface": "#EEF3FF"
    },
    "ai": {
      "base": "#6941F5",
      "text": "#5B34D6",
      "surface": "#F3F0FF"
    },
    "warning": {
      "base": "#E49412",
      "text": "#A96206",
      "surface": "#FFF8EB"
    }
  },
  "typography": {
    "display": "Space Grotesk",
    "body": "IBM Plex Sans",
    "mono": "IBM Plex Mono",
    "monoUsage": "timestamps, donor IDs, system IDs only",
    "scale": {
      "hero": { "size": 76, "weight": 600, "tracking": "-0.035em" },
      "pageTitle": { "size": 17, "weight": 700, "tracking": "-0.015em" },
      "sectionTitle": { "size": 15, "weight": 600 },
      "metricLarge": { "size": 46, "weight": 700, "tracking": "-0.03em" },
      "metric": { "size": 27, "weight": 700 },
      "metricSmall": { "size": 20, "weight": 700 },
      "body": { "size": 13, "weight": 400 },
      "bodyStrong": { "size": 13.5, "weight": 600 },
      "label": { "size": 11, "weight": 600, "tracking": "0.05em", "transform": "uppercase" },
      "meta": { "size": 11.5, "weight": 400 }
    }
  },
  "radius": { "chip": 6, "control": 7, "input": 8, "panel": 11, "card": 14, "hero": 18, "pill": 999 },
  "spacing": { "xs": 4, "sm": 8, "md": 14, "lg": 16, "xl": 22, "section": 110 },
  "size": {
    "topBar": 60,
    "sidebar": 232,
    "buttonHeight": 40,
    "inputHeight": 44,
    "tableRow": 48,
    "iconSm": 14,
    "iconMd": 16,
    "iconLg": 20
  },
  "shadow": {
    "panel": "0 1px 2px rgba(16,24,40,0.04)",
    "raised": "0 1px 3px rgba(16,24,40,0.07)",
    "overlay": "0 8px 30px rgba(16,24,40,0.07)",
    "drawer": "-10px 0 40px rgba(16,24,40,0.14)"
  },
  "status": {
    "available": { "color": "#94A3B5", "label": "Available" },
    "queued": { "color": "#94A3B5", "label": "Queued" },
    "calling": { "color": "#2E5FEA", "label": "Calling" },
    "ringing": { "color": "#E49412", "label": "Ringing" },
    "answered": { "color": "#2E5FEA", "label": "Answered" },
    "accepted": { "color": "#0E9B6C", "label": "Accepted" },
    "enRoute": { "color": "#0E9B6C", "label": "En route" },
    "arrived": { "color": "#0E9B6C", "label": "Arrived" },
    "declined": { "color": "#CDD4DF", "label": "Declined" },
    "noAnswer": { "color": "#CDD4DF", "label": "No answer" }
  },
  "lifecycle": ["triggered", "matched", "contacting", "answered", "accepted", "enRoute", "fulfilled"]
}
