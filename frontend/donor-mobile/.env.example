EXPO_PUBLIC_API_URL=http://localhost:8000
# Optional. Error reports to Sentry; leave empty to keep reporting off.
EXPO_PUBLIC_SENTRY_DSN=
# development | staging | production (tags Sentry events)
EXPO_PUBLIC_APP_ENV=development
# Public website with the privacy policy and terms (defaults to https://haemnet.in)
EXPO_PUBLIC_WEBSITE_URL=
