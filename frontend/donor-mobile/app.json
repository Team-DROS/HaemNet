{
  "expo": {
    "name": "HaemNet Donor",
    "owner": "haemnetais-team",
    "slug": "donor-mobile",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "2"
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#FFF5F4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "in.haemnet.donor",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "donor-mobile",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HaemNet Donor uses your location while the app is open to match you with hospitals within 10 km that need your blood group.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HaemNet Donor lets you choose a profile photo from your gallery. Photos stay on your phone.",
          "cameraPermission": "HaemNet Donor lets you take a profile photo with your camera. Photos stay on your phone.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#D92D20",
          "defaultChannel": "emergency-requests",
          "icon": "./assets/notification-icon.png"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94b47c7d-1958-4896-a84a-193527c8b4b3"
      }
    }
  }
}
